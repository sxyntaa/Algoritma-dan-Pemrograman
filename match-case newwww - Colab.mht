      <pre class="editor flex monaco monaco-colorized colab-classic colab-classic" contenteditable="true" data-lang="notebook-python"><span><span></span></span><br><span><span class="mtk8">#&nbsp;Lengkapi&nbsp;kode&nbsp;fungsi&nbsp;di&nbsp;bawah&nbsp;ini</span></span><br><span><span class="mtk6">def</span><span class="mtk1"> </span><span class="mtk15">hitung_diskon</span><span class="mtk1">(</span><span class="mtk16">total_belanja</span><span class="mtk1">,&nbsp;</span><span class="mtk16">hari</span><span class="mtk1">):</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk19">match</span><span class="mtk1">&nbsp;hari.title():</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk19">case</span><span class="mtk1"> </span><span class="mtk21">"Jumat"</span><span class="mtk1">&nbsp;|&nbsp;</span><span class="mtk21">"Sabtu"</span><span class="mtk1"> </span><span class="mtk19">if</span><span class="mtk1">&nbsp;total_belanja&nbsp;&gt;=&nbsp;</span><span class="mtk12">100000</span><span class="mtk1">:</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;diskon&nbsp;=&nbsp;</span><span class="mtk12">0.15</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk19">case</span><span class="mtk1"> </span><span class="mtk21">"Jumat"</span><span class="mtk1">&nbsp;|&nbsp;</span><span class="mtk21">"Sabtu"</span><span class="mtk1">:</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;diskon&nbsp;=&nbsp;</span><span class="mtk12">0.05</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk19">case</span><span class="mtk1"> </span><span class="mtk21">"Minggu"</span><span class="mtk1">:</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;diskon&nbsp;=&nbsp;</span><span class="mtk12">0.10</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk19">case</span><span class="mtk1">&nbsp;_:</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;diskon&nbsp;=&nbsp;</span><span class="mtk12">0.0</span></span><br><span><span></span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;potongan&nbsp;=&nbsp;total_belanja&nbsp;*&nbsp;diskon</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;total_bayar&nbsp;=&nbsp;total_belanja&nbsp;-&nbsp;potongan</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk19">return</span><span class="mtk1">&nbsp;total_bayar</span></span><br><span><span></span></span><br><span><span class="mtk8">#&nbsp;Uji&nbsp;coba&nbsp;kasir</span></span><br><span><span class="mtk15">print</span><span class="mtk1">(</span><span class="mtk21">"Total&nbsp;bayar&nbsp;(Jumat,&nbsp;150rb):"</span><span class="mtk1">,&nbsp;hitung_diskon(</span><span class="mtk12">150000</span><span class="mtk1">,&nbsp;</span><span class="mtk21">"jumat"</span><span class="mtk1">))</span></span><br><span><span class="mtk15">print</span><span class="mtk1">(</span><span class="mtk21">"Total&nbsp;bayar&nbsp;(Minggu,&nbsp;50rb):"</span><span class="mtk1">,&nbsp;hitung_diskon(</span><span class="mtk12">50000</span><span class="mtk1">,&nbsp;</span><span class="mtk21">"minggu"</span><span class="mtk1">))</span></span><br><span><span class="mtk15">print</span><span class="mtk1">(</span><span class="mtk21">"Total&nbsp;bayar&nbsp;(Senin,&nbsp;200rb):"</span><span class="mtk1">,&nbsp;hitung_diskon(</span><span class="mtk12">200000</span><span class="mtk1">,</span><span class="mtk21">"Senin"</span><span class="mtk1">))</span></span><br></pre><colab-form class="formview vertical layout flex"><div class="widget-area"></div>